{
	"name": "verturin/permmatrix",
	"type": "phpbb-extension",
	"description": "Permission matrix in the ACP: one tab per extension plus phpBB forum, user, moderator and admin tabs. Edit permissions per group with a confirmation summary, role-aware, and backup/restore extension permissions.",
	"homepage": "https://github.com/verturin/permmatrix",
	"version": "2.0.2",
	"time": "2026-11-21",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "verturin",
			"homepage": "https://github.com/verturin",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Forum Permission Matrix",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.14,<4.0.0@dev"
		},
		"version-check": {
			"host": "verturin.github.io",
			"directory": "/permmatrix",
			"filename": "permmatrix_version.json",
			"ssl": true
		}
	},
	"autoload": {
		"psr-4": {
			"verturin\\permmatrix\\": ""
		}
	}
}
